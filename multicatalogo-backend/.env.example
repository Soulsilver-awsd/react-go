# Copia este archivo a .env y ajusta los valores según tu entorno.
POSTGRES_USER=multicatalogo
POSTGRES_PASSWORD=multicatalogo
POSTGRES_DB=multicatalogo
POSTGRES_PORT=5432

# En un PostgreSQL gestionado (Railway/Render) usa sslmode=require.
DATABASE_URL=postgres://multicatalogo:multicatalogo@localhost:5432/multicatalogo?sslmode=disable

# Servidor HTTP
PORT=3000

# Firma de los JWT (obligatorio en producción: usa un valor aleatorio largo).
JWT_SECRET=cambia-este-secreto-en-produccion

# Orígenes permitidos por CORS (separados por comas).
# En la nube: https://tu-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Redis (Fase 3 - caché). Es opcional: sin Redis el backend consulta siempre PostgreSQL.
REDIS_PORT=6379
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
